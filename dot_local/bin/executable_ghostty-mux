#!/usr/bin/env bash
# ghostty-mux — multiplexer dispatcher for Ghostty's `command`.
#
# Exists for the herdr trial (branch: trial/herdr). Ghostty's `command` is a
# single global value, so pointing it straight at herdr would be a full cutover
# with no fallback in the same window. This reads a one-word toggle instead, so
# new windows can be aimed at either multiplexer without editing config or
# restarting Ghostty.
#
#   echo herdr > ~/.local/state/mux    # new Ghostty windows attach herdr
#   echo tmux  > ~/.local/state/mux    # back to tmux
#   rm         ~/.local/state/mux      # same as tmux (the default)
#
# Existing windows keep whatever they launched with — that is deliberate. You
# can run a herdr window next to a tmux window and compare them side by side.
#
# DEFAULT IS TMUX. The toggle must be set on purpose, so a fresh machine (or
# this branch, un-flipped) behaves exactly as main does.
#
# Full paths throughout: Ghostty's GUI launch environment does not necessarily
# have /opt/homebrew/bin on PATH. This is the same reason ghostty-tmux pins
# its tmux path.

set -u

herdr_bin=/opt/homebrew/bin/herdr
tmux_wrapper="$HOME/.local/bin/ghostty-tmux"

state_file="${XDG_STATE_HOME:-$HOME/.local/state}/mux"

choice=tmux
if [ -r "$state_file" ]; then
  read -r choice <"$state_file" || choice=tmux
fi
# Trim whitespace and lowercase so a stray newline or "Herdr" still works.
choice="$(printf '%s' "$choice" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')"

case "$choice" in
herdr)
  # Fall back rather than leave the user with a dead terminal if herdr is
  # missing (uninstalled, mid-upgrade, or the toggle outlived the trial).
  if [ -x "$herdr_bin" ]; then
    exec "$herdr_bin"
  fi
  printf 'ghostty-mux: %s not executable; falling back to tmux\n' "$herdr_bin" >&2
  exec "$tmux_wrapper"
  ;;
*)
  exec "$tmux_wrapper"
  ;;
esac
