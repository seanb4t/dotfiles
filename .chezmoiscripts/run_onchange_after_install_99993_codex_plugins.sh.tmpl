#!/bin/sh
set -eu
# marketplace: {{ include "dot_agents/plugins/marketplace.json" | sha256sum }}
command -v codex >/dev/null 2>&1 || {
    echo "Codex is required; install the codex entry from the Brewfile first." >&2
    exit 1
}
# This marketplace is already discovered at the home root through .agents/plugins.
# Use the native installer to populate its cache and resolve component paths.
python3 - <<'PY'
import json
import subprocess

listing = subprocess.run(
    ['codex', 'plugin', 'list', '--marketplace', 'fzymgc-house-skills', '--json'],
    capture_output=True, text=True, check=True)
installed = {p['name']: p for p in json.loads(listing.stdout)['installed']}
for name in ['homelab', 'pr-review', 'jj', 'superpowers']:
    if installed.get(name, {}).get('enabled') is False:
        print('Preserving disabled Codex plugin: ' + name)
        continue
    subprocess.run(['codex', 'plugin', 'add', name + '@fzymgc-house-skills', '--json'],
                   stdout=subprocess.DEVNULL, check=True)
PY
