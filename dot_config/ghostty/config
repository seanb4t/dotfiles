
copy-on-select = true

font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true

macos-option-as-alt = left

macos-titlebar-style = transparent

mouse-scroll-multiplier = 0.5

# theme = GitHub Dark
theme = Espresso

window-decoration = true
window-padding-x = 8
window-padding-y = 8
window-save-state = always
window-vsync = false

custom-shader-animation = false

keybind = global:cmd+shift+grave_accent=toggle_quick_terminal



# Disable ghostty tabs/panes - let tmux handle these
keybind = cmd+shift+t=unbind
keybind = cmd+t=unbind
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+enter=unbind

focus-follows-mouse = true

# Ghostty.app auto-attaches a multiplexer via a wrapper. ghostty-mux dispatches
# on ~/.local/state/mux: unset/"tmux" (the default) runs ghostty-tmux exactly as
# before — first window owns `main`, later windows get independent grouped views
# (shared window set); "herdr" attaches herdr instead, for the trial on branch
# trial/herdr. cmux.app ignores this.
command = /Users/sean/.local/bin/ghostty-mux

